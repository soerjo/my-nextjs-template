# Application Configuration
NEXT_PUBLIC_APP_NAME="My App"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Enable dummy mode for auth (true/1 to enable, leave empty/false for normal mode)
NEXT_PUBLIC_DUMMY_MODE=""

# Optional browser-side override of the API base URL.
# Leave empty to use the relative "/api" path (proxied by the Next.js rewrite below).
NEXT_PUBLIC_API_URL=""

# Server-side target that the "/api/:path*" rewrite proxies to.
# NOT prefixed with NEXT_PUBLIC_ — kept server-only so it is never exposed to the browser.
API_PROXY_TARGET="http://localhost:3000"

# Browser-exposed backend service URL (legacy public var from example.env.local).
# Not currently read by the app — API access goes through the relative "/api" proxy above.
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"

# Deprecated: no code reads these (Google OAuth is not wired up in this template).
# Kept commented out for reference only; safe to remove.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
